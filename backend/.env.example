# DeepSeek API key (必填) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Stripe secret key (必填，启用付费墙才需要) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe 支付成功/取消后跳回前端的地址
# 本地开发：http://localhost:5173/#success
# 生产环境：https://你的前端域名/#success
STRIPE_SUCCESS_URL=http://localhost:5173/#success
STRIPE_CANCEL_URL=http://localhost:5173/

# 服务端口（Railway 会自动注入 PORT，本地默认 8787）
PORT=8787
